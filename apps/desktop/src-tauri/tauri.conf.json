{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuner",
  "version": "0.1.0",
  "identifier": "com.measdev.tuner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tuner",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0B0C",
        "transparent": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "lib/libmpv-2.dll": "lib/libmpv-2.dll",
      "lib/libmpv-wrapper.dll": "lib/libmpv-wrapper.dll",
      "lib/vcruntime140.dll": "vcruntime140.dll"
    }
  }
}
